---
const images = import.meta.glob<{ default: ImageMetadata }>('/public/gallery/*.{jpeg,jpg,png,gif,webp}');
const imageEntries = Object.entries(images);
---

{imageEntries.length === 0 ? (
  <!-- No gallery images found -->
) : (
  <section class="section-padding bg-cream">
    <div class="container">
      <h2 class="text-3xl md:text-4xl font-bold text-center text-pittsburgh-black mb-12" style="font-family: Georgia, serif;">
        Gallery
      </h2>

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
        {imageEntries.map(([path]) => {
          const imagePath = path.replace('/public', '');
          return (
            <div class="aspect-square overflow-hidden rounded-lg shadow-md hover:shadow-xl transition-shadow">
              <img
                src={imagePath}
                alt="Finn McCool's atmosphere"
                class="w-full h-full object-cover hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}
