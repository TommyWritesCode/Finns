---
// Location Tab Bar — sticky, pure CSS anchor links, zero JS toggle
---

<nav class="tab-bar" aria-label="Jump to location">
  <div class="tab-bar-inner">
    <div class="tab-bar-tabs">
      <a href="#oakland" class="tab-link">Oakland</a>
      <a href="#southside" class="tab-link">South Side</a>
    </div>
    <div class="tab-bar-info" aria-label="Hours and contact">
      <span>Thu&ndash;Sat &middot; 6PM&ndash;2AM</span>
      <span class="tab-bar-sep">&middot;</span>
      <a href="tel:+14122515918" class="tab-bar-phone">(412) 251-5918</a>
    </div>
  </div>
</nav>

<style>
  .tab-bar {
    position: fixed;
    top: 64px; /* mobile header height */
    left: 0;
    right: 0;
    width: 100%;
    z-index: 40;
    background-color: #0f1a14;
    border-bottom: 1px solid #D4A84B;
  }

  @media (min-width: 768px) {
    .tab-bar {
      top: 72px; /* desktop header height */
    }
  }

  .tab-bar-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 1rem;
    display: flex;
    align-items: stretch;
    justify-content: space-between;
    gap: 1rem;
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab-bar-inner::-webkit-scrollbar {
    display: none;
  }

  .tab-bar-tabs {
    display: flex;
    align-items: stretch;
    gap: 0;
    flex-shrink: 0;
  }

  .tab-link {
    display: flex;
    align-items: center;
    color: #F4ECD8;
    font-family: 'Inter', system-ui, sans-serif;
    font-weight: 600;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    padding: 0.875rem 1.5rem;
    border-bottom: 3px solid transparent;
    transition: color 0.2s, border-color 0.2s;
    text-decoration: none;
    white-space: nowrap;
  }

  .tab-link:hover {
    color: #D4A84B;
    border-bottom-color: #D4A84B;
  }

  .tab-bar-info {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.75rem;
    color: #D4A84B;
    letter-spacing: 0.06em;
    white-space: nowrap;
    flex-shrink: 0;
    padding: 0 0.25rem;
  }

  .tab-bar-sep {
    opacity: 0.5;
  }

  .tab-bar-phone {
    color: #D4A84B;
    text-decoration: none;
    transition: opacity 0.2s;
  }

  .tab-bar-phone:hover {
    opacity: 0.8;
  }

  @media (max-width: 640px) {
    .tab-bar-info {
      display: none;
    }

    .tab-link {
      flex: 1;
      justify-content: center;
      padding: 0.875rem 1rem;
    }

    .tab-bar-tabs {
      width: 100%;
    }
  }
</style>
