---
import HoursCard from "./HoursCard.astro";

interface Photo {
  src: string;
  alt: string;
}

interface Location {
  id: string;
  name: string;
  tagline: string;
  address: string;
  city: string;
  state: string;
  zip: string;
  phone: string;
  phoneDisplay: string;
  hours: string;
  hoursNote: string;
  mapsUrl: string;
  features: string[];
}

interface Props {
  location: Location;
  accentColor?: 'dark' | 'green';
  imageUrl: string;
  imageAlt: string;
  reversed?: boolean;
  photos?: Photo[];
}

const {
  location,
  imageUrl,
  imageAlt,
  reversed = false,
  photos = [],
} = Astro.props;
---

<section
  id={location.id}
  class:list={['location-section', reversed ? 'location-section--reversed' : '']}
  style="scroll-margin-top: 116px;"
>
  <!-- Photo full width on top with address overlay -->
  <div class="location-photo">
    {photos.length > 0 ? (
      <div class="photo-slider" id={`slider-${location.id}`}>
        {photos.map((photo, i) => (
          <img
            src={photo.src}
            alt={photo.alt}
            class:list={['slider-img', i === 0 ? 'slider-img--active' : '']}
            loading={i === 0 ? 'eager' : 'lazy'}
          />
        ))}
        <button class="slider-btn slider-btn--prev" aria-label="Previous photo">&#8592;</button>
        <button class="slider-btn slider-btn--next" aria-label="Next photo">&#8594;</button>
        <div class="slider-dots">
          {photos.map((_, i) => (
            <span class:list={['slider-dot', i === 0 ? 'slider-dot--active' : '']} data-index={i}></span>
          ))}
        </div>
      </div>
    ) : (
      <img src={imageUrl} alt={imageAlt} class="location-photo-img" loading="lazy" />
    )}
    <div class="photo-address-overlay">
      <p class="photo-address-text">{location.address} &middot; {location.city}, {location.state} {location.zip}</p>
    </div>
  </div>

  <!-- Content centered below the photo -->
  <div class="location-content">
    <h2 class="location-name">{location.name}</h2>
    <p class="location-tagline">{location.tagline}</p>
    <HoursCard />
    <a
      href={location.mapsUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="location-directions-btn"
    >
      Get Directions
    </a>
    <a href={`tel:${location.phone}`} class="location-phone">
      {location.phoneDisplay}
    </a>
    <ul class="location-features" aria-label="Features">
      {location.features.map((feature) => (
        <li class="location-feature-item">
          <span class="feature-bullet" aria-hidden="true">&#9752;</span>
          <span>{feature}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* ── Desktop: side-by-side grid ── */
  .location-section {
    background-color: #0f1a14;
    border-top: 1px solid rgba(212, 168, 75, 0.2);
    display: grid;
    grid-template-columns: 55% 45%;
    min-height: 600px;
  }

  .location-section--reversed {
    grid-template-columns: 45% 55%;
  }

  .location-section--reversed .location-photo {
    order: 2;
  }

  .location-section--reversed .location-content {
    order: 1;
  }

  /* ── Photo ── */
  .location-photo {
    position: relative;
    overflow: hidden;
  }

  .location-photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .photo-slider {
    position: absolute;
    inset: 0;
  }

  .slider-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .slider-img--active {
    opacity: 1;
  }

  .slider-btn {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background: rgba(10, 20, 12, 0.7);
    border: 1px solid rgba(212, 168, 75, 0.6);
    color: #D4A84B;
    font-size: 1.25rem;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: background 0.2s;
    z-index: 10;
  }

  .slider-btn:hover { background: rgba(10, 20, 12, 0.9); }
  .slider-btn--prev { left: 1rem; }
  .slider-btn--next { right: 1rem; }

  .slider-dots {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    gap: 0.4rem;
    z-index: 10;
  }

  .slider-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: rgba(244, 236, 216, 0.4);
    transition: background 0.2s;
    cursor: pointer;
  }

  .slider-dot--active { background: #D4A84B; }

  /* Address pinned to bottom of photo */
  .photo-address-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.72) 0%, transparent 100%);
    padding: 2.5rem 1.5rem 1rem;
    z-index: 5;
  }

  .photo-address-text {
    color: #F4ECD8;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    margin: 0;
    text-align: center;
    letter-spacing: 0.03em;
    opacity: 0.92;
  }

  /* ── Content ── */
  .location-content {
    padding: 3.5rem 3rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 1.25rem;
    justify-content: center;
  }

  .location-name {
    color: #F4ECD8;
    font-family: 'Playfair Display', Georgia, serif;
    font-size: clamp(1.75rem, 3vw, 2.5rem);
    font-weight: 900;
    margin: 0;
    line-height: 1.15;
  }

  .location-tagline {
    color: #D4A84B;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 1rem;
    margin: 0;
    opacity: 0.85;
  }

  .location-directions-btn {
    display: inline-block;
    padding: 0.6rem 1.75rem;
    background-color: transparent;
    border: 1px solid #D4A84B;
    color: #D4A84B;
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 3px;
    transition: background-color 0.2s, color 0.2s;
  }

  .location-directions-btn:hover {
    background-color: #D4A84B;
    color: #0f1a14;
  }

  .location-phone {
    color: rgba(244, 236, 216, 0.85);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    letter-spacing: 0.04em;
  }

  .location-phone:hover { opacity: 0.7; }

  .location-features {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 100%;
  }

  .location-feature-item {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 0.5rem;
    color: rgba(244, 236, 216, 0.75);
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 0.875rem;
    line-height: 1.6;
  }

  .feature-bullet {
    color: #D4A84B;
    font-size: 0.75em;
    opacity: 0.6;
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  /* ── Mobile: stack vertically ── */
  @media (max-width: 767px) {
    .location-section {
      display: flex;
      flex-direction: column;
    }

    .location-section--reversed .location-photo {
      order: 1;
    }

    .location-section--reversed .location-content {
      order: 2;
    }

    .location-photo {
      height: 250px;
    }

    .slider-btn,
    .slider-dots {
      display: none;
    }

    .location-content {
      padding: 2rem 1.25rem;
    }

    .location-directions-btn {
      width: 100%;
      text-align: center;
      box-sizing: border-box;
    }
  }
</style>

<script>
  document.querySelectorAll('.photo-slider').forEach((slider) => {
    const imgs = slider.querySelectorAll('.slider-img');
    const dots = slider.querySelectorAll('.slider-dot');
    let current = 0;

    function goTo(n: number) {
      imgs[current].classList.remove('slider-img--active');
      dots[current].classList.remove('slider-dot--active');
      current = (n + imgs.length) % imgs.length;
      imgs[current].classList.add('slider-img--active');
      dots[current].classList.add('slider-dot--active');
    }

    slider.querySelector('.slider-btn--prev')?.addEventListener('click', () => goTo(current - 1));
    slider.querySelector('.slider-btn--next')?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    let timer = setInterval(() => goTo(current + 1), 4000);
    slider.addEventListener('mouseenter', () => clearInterval(timer));
    slider.addEventListener('mouseleave', () => { timer = setInterval(() => goTo(current + 1), 4000); });
  });
</script>
